# Frontend: copy to .env.local for development.
# In Railway, set this on the FRONTEND service to the backend public HTTPS origin.
# Do not include /api. Rebuild the frontend after changing it.
# Missing configuration does not fall back to synthetic data.
VITE_API_URL=http://localhost:8000
# API persistence and protected CSV import (Railway API service only)
DATA_DIR=/data
# Set a strong secret in Railway. Do not put this in the frontend service.
ADMIN_USERNAME=Admin
ADMIN_API_KEY=Admin
